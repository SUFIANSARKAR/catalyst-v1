# Provider
CATALYST_BASE_URL=https://api.openai.com/v1
CATALYST_MODEL=
CATALYST_API_KEY=
CATALYST_EMBEDDING_MODEL=

# Durable state
CATALYST_DATA_ROOT=catalyst_data
CATALYST_MEMORY_PATH=catalyst_data/memory.db
CATALYST_MIND_PATH=catalyst_data/mind.db
CATALYST_WORKSPACE=workspace

# Authentication and browser boundaries
CATALYST_ADMIN_PASSWORD_SHA256=
CATALYST_API_TOKEN=
CATALYST_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CATALYST_COMPUTER_USE_ALLOWED_DOMAINS=
CATALYST_COMPUTER_USE_REQUIRE_APPROVAL=true

# Catalyst persona and voice
CATALYST_VOICE_PRESET=natural-female
CATALYST_VOICE_MODEL=gpt-4o-mini-tts
CATALYST_VOICE_NAME=nova
CATALYST_VOICE_BREATHING=true
CATALYST_AUTO_SPEAK=false

# Governed autonomy
CATALYST_AUTONOMOUS_COGNITION=false
CATALYST_AUTONOMOUS_AUTO_DISPATCH=false
CATALYST_APPROVAL_MODE=prompt
CATALYST_ALLOW_SHELL=false

# Runtime
PORT=8000
